# Web server inside the container.
# /api, /sanctum and /up go to the Python API (uvicorn); everything else is the React app.
:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	@api path /api/* /sanctum/* /up
	handle @api {
		reverse_proxy 127.0.0.1:9000
	}

	# Built JS / CSS files have a hash in their name: cache them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

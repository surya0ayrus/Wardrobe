# Web server inside the container.
# /api, /sanctum and /up go to Laravel (PHP-FPM); everything else is the React app.
:{$PORT:8080} {
	root * /var/www/html/public
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	@laravel path /api/* /sanctum/* /up
	handle @laravel {
		php_fastcgi 127.0.0.1:9000 {
			trusted_proxies private_ranges
		}
	}

	# Built JS / CSS files have a hash in their name: cache them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

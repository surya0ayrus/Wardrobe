{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (FastAPI, port 8082)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8082"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env"
    },
    {
      "name": "Frontend (Vite, port 5176)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    { "name": "Full app (API + Frontend)", "configurations": ["API (FastAPI, port 8082)", "Frontend (Vite, port 5176)"] }
  ]
}

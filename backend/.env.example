APP_NAME="Base App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082
FRONTEND_URL=http://localhost:5176

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=base_app
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Keep unique per app when apps share a Redis server, or one app's cache:clear wipes the others'.
REDIS_PREFIX=base_app_

# Production: CACHE_STORE=redis and QUEUE_CONNECTION=redis.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
# Keep null: cookies stay on this app's own address. Never a shared parent domain,
# or apps on sibling sub-domains overwrite each other's XSRF-TOKEN (saves then fail with 419).
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:5176,127.0.0.1:5176

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Accounts (config/base.php)
APP_DEFAULT_PASSWORD=Welcome@123
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=Admin@123
DEFAULT_COMPANY_NAME="My Company Pvt Ltd"
DEFAULT_COMPANY_SHORT_NAME=MAIN

# ── Production (Docker) ─────────────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://app.example.com
# SANCTUM_STATEFUL_DOMAINS=app.example.com
# SESSION_SECURE_COOKIE=true
# LOG_CHANNEL=stderr
# PORT=8080            # port the container listens on (set by the platform)

APP_NAME="Base App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8082
FRONTEND_URL=http://localhost:5176

BCRYPT_ROUNDS=12

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=base_app
DB_USERNAME=postgres
DB_PASSWORD=
# DB_URL=postgresql://user:pass@host:5432/dbname   (optional, replaces the DB_* parts)

# Cache + login throttling. "redis" in production (several workers); anything else = in memory.
CACHE_STORE=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Keep unique per app when apps share a Redis server.
REDIS_PREFIX=base_app_

SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Accounts (app/config.py)
APP_DEFAULT_PASSWORD=Welcome@123
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=Admin@123
DEFAULT_COMPANY_NAME="My Company Pvt Ltd"
DEFAULT_COMPANY_SHORT_NAME=MAIN

# ── Production (Docker) ─────────────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://app.example.com
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=redis
# PORT=8080            # port the container listens on (set by the platform)
